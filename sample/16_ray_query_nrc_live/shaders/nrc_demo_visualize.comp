#version 460
#pragma shader_stage(compute)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D nrcDemoOutImage;
layout(set = 0, binding = 1, rgba32f) readonly uniform image2D nrcDemoBiasFactorR;

layout(push_constant) uniform NrcDemoVisualizeConstants {
    float blend;
} nrcDemoVisualizeConstants;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(nrcDemoOutImage);
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    vec3 original = imageLoad(nrcDemoOutImage, coord).rgb;
    vec4 storedPrediction = imageLoad(nrcDemoBiasFactorR, coord);
    if (storedPrediction.a > 0.5) {
        return;
    }

    vec3 prediction = max(storedPrediction.rgb, vec3(0.0));
    vec3 color = mix(original, prediction, clamp(nrcDemoVisualizeConstants.blend, 0.0, 1.0));
    imageStore(nrcDemoOutImage, coord, vec4(color, 1.0));
}
