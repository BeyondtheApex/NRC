#version 460

#include "nrc/passes/NrcQueueOps.glsl"

#define NRC_SAMPLE_SCENE_BINDING 3
#include "sample_scene.glsl"

layout(local_size_x = NRC_QUEUE_RESET_WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform NrcSampleProducerConstants {
    uint mode;
    uint evalCapacity;
    uint pixelCount;
    uint width;
    uint height;
    uint trainRecordCount;
} nrcSampleProducerConstants;

bool NrcSamplePackedInput(uvec2 pixel, out PackedNrcInput packedInput) {
    return NrcSampleTracePrimaryPackedInput(pixel,
                                            uvec2(nrcSampleProducerConstants.width,
                                                  nrcSampleProducerConstants.height),
                                            packedInput);
}

void main() {
    if (nrcSampleProducerConstants.mode == 0u) {
        NrcQueueResetMain();
        return;
    }

    uint pixelIndex = gl_GlobalInvocationID.x;
    if (pixelIndex >= nrcSampleProducerConstants.pixelCount) {
        return;
    }

    uvec2 pixel = uvec2(pixelIndex % nrcSampleProducerConstants.width,
                        pixelIndex / nrcSampleProducerConstants.width);
    PackedNrcInput screenInput;
    if (!NrcSamplePackedInput(pixel, screenInput)) {
        return;
    }

    uint evalIndex;
    NrcPushEvalRecord(NrcMakeEvalScreen(screenInput, pixel),
                      nrcSampleProducerConstants.evalCapacity,
                      evalIndex);

    if (pixelIndex == 0u && nrcSampleProducerConstants.trainRecordCount != 0u) {
        PackedNrcInput trainInput;
        if (!NrcSamplePackedInput(uvec2(0u, 0u), trainInput)) {
            return;
        }

        uint firstTrainIndex;
        uint reservedTrainCount;
        if (NrcReserveTrainRecords(0u,
                                   nrcSampleProducerConstants.trainRecordCount,
                                   firstTrainIndex,
                                   reservedTrainCount)) {
            vec3 trainBias;
            vec3 trainFactor;
            NrcSampleDirectLightingPayload(trainInput, trainBias, trainFactor);
            NrcTrainRecord trainRecord = NrcMakeTrainRecord(trainBias, trainFactor, trainInput);
            NrcStoreTrainRecords(0u, firstTrainIndex, reservedTrainCount, trainRecord);
            if (reservedTrainCount != 0u) {
                NrcPushEvalRecord(NrcMakeEvalTrain(trainInput,
                                                   0u,
                                                   firstTrainIndex,
                                                   firstTrainIndex + reservedTrainCount - 1u),
                                  nrcSampleProducerConstants.evalCapacity,
                                  evalIndex);
            }
        }
    }
}
